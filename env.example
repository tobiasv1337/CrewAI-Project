# LLM Configuration
GWDG_API_KEY=
GWDG_API_BASE=https://chat-ai.academiccloud.de/v1
STUDY_ASSISTANT_MODEL=qwen3.5-122b-a10b
STUDY_ASSISTANT_MANAGER_MODEL=qwen3.5-397b-a17b
STUDY_ASSISTANT_LLM_TIMEOUT_SECONDS=300
# Orchestrator and optional planner enable thinking; specialists disable it.
STUDY_ASSISTANT_THINKING_MAX_TOKENS=16384
# Intent classification uses the manager model with thinking and its own budget.
STUDY_ASSISTANT_CLASSIFIER_MAX_TOKENS=4096
STUDY_ASSISTANT_CLASSIFIER_TIMEOUT_SECONDS=120
# Lightweight non-thinking model for proposal decisions and live trace narration.
STUDY_ASSISTANT_OBSERVER_MODEL=qwen3-30b-a3b-instruct-2507
# Applies to proposal decisions and narration. These bounded JSON
# calls do not retry; errors use their existing safe fallbacks.
# All observer calls disable thinking using the model backend's API controls.
# Reasoning-only models cannot be observers or specialists.
STUDY_ASSISTANT_OBSERVER_TIMEOUT_SECONDS=120


# ISIS/Moodle credentials
ISIS_USERNAME=
ISIS_PASSWORD=
